<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/promoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_promo_indigo"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Large faded illustration on the right -->
    <ImageView
        android:id="@+id/ivPromoIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-14dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        app:tint="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="96dp">

        <TextView
            android:id="@+id/tvPromoTag"
            style="@style/SkillConnect.Pill"
            android:backgroundTint="#33FFFFFF"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPromoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPromoSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:textColor="@color/white_70"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPromoCta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
