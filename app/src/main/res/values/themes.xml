<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SkillConnect" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="colorTertiary">@color/secondary</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>

        <item name="materialButtonStyle">@style/Widget.SkillConnect.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.SkillConnect.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.SkillConnect.Card</item>
        <item name="textInputStyle">@style/Widget.SkillConnect.TextInput</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SkillConnect.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SkillConnect.Dialog</item>
    </style>

    <style name="Theme.SkillConnect.Splash">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primary</item>
    </style>

    <style name="ThemeOverlay.SkillConnect.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SkillConnect.BottomSheet</item>
    </style>

    <style name="Widget.SkillConnect.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="ThemeOverlay.SkillConnect.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.SkillConnect.Large</item>
    </style>

    <style name="ShapeAppearance.SkillConnect.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.SkillConnect.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.SkillConnect.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.SkillConnect.RoundedSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
