rules_version = '2';

// SkillConnect – Cloud Firestore security rules
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
//
// Roles are stored in users/{uid}.role : CUSTOMER | PROVIDER | ADMIN (users can never change their own role).
// Anything not explicitly allowed below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function docPath(collection, id) { return /databases/$(database)/documents/$(collection)/$(id); }
    function userDoc() { return get(docPath('users', uid())).data; }
    function hasRole(role) { return signedIn() && exists(docPath('users', uid())) && userDoc().role == role; }
    function isAdmin() { return hasRole('ADMIN'); }
    function isProvider() { return hasRole('PROVIDER'); }
    function isCustomer() { return hasRole('CUSTOMER'); }
    // Keys whose value is different after this write
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function incoming() { return request.resource.data; }

    // ---------------- users (private profile: name, phone, address, role, FCM token) ----------------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      // Users create only their own document, as CUSTOMER or PROVIDER, and active
      allow create: if signedIn() && uid() == userId
                    && incoming().userId == userId
                    && incoming().role in ['CUSTOMER', 'PROVIDER']
                    && incoming().get('active', true) == true;
      // Owners edit their profile but never their id, role or active flag
      allow update: if (signedIn() && uid() == userId
                        && !changed().hasAny(['userId', 'role', 'active']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------- providers (public listing) ----------------
    // A customer submitting a review may update ONLY the rating fields, and only so that they
    // reflect exactly one new review for this provider, created in the same transaction.
    function isRatingUpdateForNewReview(providerId) {
      let reviewId = incoming().lastReviewId;
      let review = getAfter(docPath('reviews', reviewId)).data;
      let oldCount = resource.data.get('reviewCount', 0);
      let oldTotal = resource.data.get('ratingTotal', resource.data.get('averageRating', 0) * oldCount);
      let newCount = incoming().reviewCount;
      let newTotal = incoming().ratingTotal;
      return isCustomer()
          && changed().hasOnly(['averageRating', 'reviewCount', 'ratingTotal', 'lastReviewId'])
          && reviewId is string
          && !exists(docPath('reviews', reviewId))          // the review is new in this transaction
          && existsAfter(docPath('reviews', reviewId))
          && review.customerId == uid()
          && review.providerId == providerId
          && newCount == oldCount + 1
          && math.abs(newTotal - (oldTotal + review.rating)) < 0.01
          // float(): whole-number values would otherwise use integer division
          && math.abs(incoming().averageRating - float(newTotal) / float(newCount)) < 0.051;   // rounded to 1 decimal
    }

    match /providers/{providerId} {
      // Any signed-in user can browse listings (name, skills, price, phone for "Call", location)
      allow read: if signedIn();
      // A provider creates only their own listing: active, unverified and without ratings
      allow create: if (isProvider() && uid() == providerId
                        && incoming().providerId == providerId
                        && incoming().get('active', true) == true
                        && incoming().get('verified', false) == false
                        && incoming().get('averageRating', 0) == 0
                        && incoming().get('reviewCount', 0) == 0
                        && incoming().get('ratingTotal', 0) == 0)
                    || isAdmin();
      allow update: if
          // the owner edits their profile, but never verification, ratings or active status
          (signedIn() && uid() == providerId
             && !changed().hasAny(['providerId', 'verified', 'active', 'averageRating', 'reviewCount',
                                   'ratingTotal', 'lastReviewId']))
          || isRatingUpdateForNewReview(providerId)
          || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------- bookings (visible only to its customer, its provider and admins) ----------------
    match /bookings/{bookingId} {
      allow read: if signedIn()
                  && (resource.data.customerId == uid() || resource.data.providerId == uid() || isAdmin());

      allow create: if isCustomer()
                    && incoming().bookingId == bookingId
                    && incoming().customerId == uid()
                    && incoming().providerId is string
                    && incoming().providerId != uid()
                    && exists(docPath('providers', incoming().providerId))
                    && incoming().status == 'PENDING'
                    && incoming().reviewed == false;

      allow update: if
          // provider: accept or decline a request, complete or drop an accepted job
          (signedIn() && resource.data.providerId == uid()
             && changed().hasOnly(['status', 'updatedAt'])
             && ((resource.data.status == 'PENDING' && incoming().status in ['ACCEPTED', 'REJECTED'])
                 || (resource.data.status == 'ACCEPTED' && incoming().status in ['COMPLETED', 'REJECTED'])))
          // customer: cancel while the booking is still open
          || (signedIn() && resource.data.customerId == uid()
             && changed().hasOnly(['status', 'updatedAt'])
             && resource.data.status in ['PENDING', 'ACCEPTED']
             && incoming().status == 'CANCELLED')
          // customer: mark as reviewed, only together with creating the review for this booking
          || (signedIn() && resource.data.customerId == uid()
             && changed().hasOnly(['reviewed', 'updatedAt'])
             && resource.data.status == 'COMPLETED'
             && resource.data.reviewed == false
             && incoming().reviewed == true
             && existsAfter(docPath('reviews', bookingId)))
          || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------- reviews (public, one per completed booking, never edited by users) ----------------
    function isValidNewReview(reviewId) {
      let booking = get(docPath('bookings', reviewId)).data;
      return isCustomer()
          && incoming().reviewId == reviewId
          && incoming().bookingId == reviewId
          && incoming().customerId == uid()
          && incoming().rating is number
          && incoming().rating >= 1 && incoming().rating <= 5
          && incoming().get('comment', '') is string
          && incoming().get('comment', '').size() <= 1000
          && booking.customerId == uid()
          && booking.providerId == incoming().providerId
          && booking.status == 'COMPLETED'
          && booking.reviewed == false
          // the booking flag and the provider's rating must change in the same transaction
          && getAfter(docPath('bookings', reviewId)).data.reviewed == true
          && getAfter(docPath('providers', incoming().providerId)).data.lastReviewId == reviewId;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      // reviewId == bookingId, and "create" only succeeds if the document doesn't exist yet,
      // so each booking can be reviewed at most once
      allow create: if isValidNewReview(reviewId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------------- portfolio ----------------
    match /portfolio/{portfolioId} {
      allow read: if signedIn();
      allow create: if (isProvider() && incoming().providerId == uid()) || isAdmin();
      allow update: if (signedIn() && resource.data.providerId == uid() && incoming().providerId == uid()) || isAdmin();
      allow delete: if (signedIn() && resource.data.providerId == uid()) || isAdmin();
    }

    // ---------------- favorites (cloud backup of SQLite favorites, private) ----------------
    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && (resource == null || resource.data.customerId == uid());
      allow create, update: if signedIn() && incoming().customerId == uid()
                            && favoriteId == uid() + '_' + incoming().providerId;
    }

    // ---------------- chats/{customerId_providerId} (private to the two people in it) ----------------
    function isChatMember(chat) { return signedIn() && (chat.customerId == uid() || chat.providerId == uid()); }

    match /chats/{chatId} {
      // "get" on a chat that doesn't exist yet is allowed so the app can create it on first open
      allow get: if signedIn() && (resource == null || isChatMember(resource.data));
      // The app lists chats with customerId == uid (customers) or providerId == uid (providers)
      allow list: if signedIn() && (resource.data.customerId == uid() || resource.data.providerId == uid());
      allow create: if isChatMember(incoming())
                    && incoming().customerId != incoming().providerId
                    && chatId == incoming().customerId + '_' + incoming().providerId
                    && incoming().chatId == chatId
                    && incoming().participants == [incoming().customerId, incoming().providerId]
                    && exists(docPath('providers', incoming().providerId))
                    && incoming().get('unreadCustomer', 0) == 0
                    && incoming().get('unreadProvider', 0) == 0;
      // members update the summary (last message, time, unread counters), never who is in the chat
      allow update: if isChatMember(resource.data)
                    && changed().hasOnly(['lastMessage', 'lastSenderId', 'updatedAt', 'unreadCustomer', 'unreadProvider'])
                    && (!changed().hasAny(['lastSenderId']) || incoming().lastSenderId == uid());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chat() { return get(docPath('chats', chatId)).data; }
        allow read: if isChatMember(chat()) || isAdmin();
        // you can only send messages as yourself, into a chat you belong to
        allow create: if isChatMember(chat())
                      && incoming().senderId == uid()
                      && incoming().messageId == messageId
                      && ((incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000)
                          || (incoming().imageUrl is string && incoming().imageUrl.size() > 0));
        allow update, delete: if isAdmin();
      }
    }

    // ---------------- categories (read-only reference data) ----------------
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
